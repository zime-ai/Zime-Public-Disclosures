---
// Testable Credentials required sections (Hand-Off Kit §10). The Markdown body covers
// "What this page is", scope and qualifications; the claim register, Probe Deeper,
// prompts and revision record render from front matter.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DisclosureMeta from '../components/DisclosureMeta.astro';
import ClaimRegister from '../components/ClaimRegister.astro';
import ProbeDeeper from '../components/ProbeDeeper.astro';
import InquiryPrompt from '../components/InquiryPrompt.astro';
import RelatedArtifacts from '../components/RelatedArtifacts.astro';
import PrinciplesDeclaration from '../components/PrinciplesDeclaration.astro';
import { getAllArtifacts, formatDate, type Artifact } from '../utils/content';
import { relatedGroups, resolveRef } from '../utils/relationships';
import { jsonLdHead } from '../utils/jsonld';
import { neutralPrompt } from '../utils/prompts';

interface Props {
	entry: Artifact;
}
const { entry } = Astro.props;
const d = entry.data as Extract<Artifact['data'], { artifact_type: 'testable_credentials' }>;
const all = await getAllArtifacts();
const target = resolveRef(d.for_artifact, all);
const prompt = neutralPrompt({ title: target.title, id: d.for_artifact, version: d.version, date: formatDate(d.updated_date ?? d.publication_date) });
---

<StarlightPage frontmatter={{ title: d.title, description: d.summary, head: jsonLdHead(entry, Astro.site) }}>
	<p class="pd-summary">{d.summary}</p>
	<p>Credentials for: {target.href ? <a href={target.href}>{target.title}</a> : target.title}</p>
	<DisclosureMeta entry={entry} />
	<slot />
	<ClaimRegister claims={d.claims} />
	<ProbeDeeper promptSets={d.prompt_sets} basePrompt={prompt} />
	<InquiryPrompt prompt={prompt} label="AI inquiry prompt" />
	<section aria-labelledby="pd-human-h">
		<h2 id="pd-human-h">Human inquiry and correction path</h2>
		<p><a href={d.inquiry_url}>Ask a question or challenge a claim</a> · <a href={d.correction_url}>Report an error</a></p>
	</section>
	<section aria-labelledby="pd-rev-h">
		<h2 id="pd-rev-h">Revision record</h2>
		{d.revision_record.length === 0 ? <p>No revisions yet.</p> : (
			<ol>{d.revision_record.map((r) => <li>v{r.version} · {formatDate(r.date)} · {r.change}</li>)}</ol>
		)}
	</section>
	<RelatedArtifacts groups={relatedGroups(entry, all)} />
	<PrinciplesDeclaration principlesVersion={d.principles_version} status={d.status} />
</StarlightPage>
