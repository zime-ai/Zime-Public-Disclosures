---
interface Props {
	path?: string;
	claimCount?: number;
}
const { path, claimCount = 0 } = Astro.props;
---

{path && (
	<aside class="pd-panel" aria-label="Testable Credentials">
		<p>
			<strong>Testable Credentials.</strong>
			{claimCount > 0 ? ` ${claimCount} material claim${claimCount === 1 ? '' : 's'} in this disclosure can be inspected, qualified or challenged.` : ' Inspect the claims, evidence paths and constraints behind this disclosure.'}
		</p>
		<p><a href={path}>Inspect the claims →</a></p>
	</aside>
)}
