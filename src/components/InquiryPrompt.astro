---
// Platform-independent, copyable prompt with a visible caution (Hand-Off Kit §10).
// External AI links are optional and configurable because URL formats change.
interface Props {
	prompt: string;
	label?: string;
	links?: { label: string; href: string }[];
}
const { prompt, label = 'AI inquiry prompt', links = [] } = Astro.props;
---

<figure class="pd-prompt">
	<figcaption>{label}</figcaption>
	<pre><code>{prompt}</code></pre>
	<button type="button" class="pd-copy" data-prompt={prompt}>Copy prompt</button>
	{links.length > 0 && (
		<p class="pd-small">Open in: {links.map((l, i) => (<>{i > 0 && ' · '}<a href={l.href} rel="noopener">{l.label}</a></>))}</p>
	)}
	<p class="pd-small pd-caution">AI answers are diagnostic, not proof. Check the sources they cite.</p>
</figure>

<script>
	document.querySelectorAll<HTMLButtonElement>('.pd-copy').forEach((btn) => {
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.prompt ?? '');
				btn.textContent = 'Copied';
				setTimeout(() => (btn.textContent = 'Copy prompt'), 1500);
			} catch {
				btn.textContent = 'Select the text above to copy';
			}
		});
	});
</script>
