---
import type { ResolvedLink } from '../utils/relationships';

interface Props {
	groups: { label: string; links: ResolvedLink[] }[];
}
const { groups } = Astro.props;
---

{groups.length > 0 && (
	<section class="pd-related" aria-labelledby="pd-related-h">
		<h2 id="pd-related-h">Related</h2>
		{groups.map((g) => (
			<div>
				<h3>{g.label}</h3>
				<ul>
					{g.links.map((l) => (
						<li>{l.href ? <a href={l.href}>{l.title}</a> : <span>{l.title}</span>}</li>
					))}
				</ul>
			</div>
		))}
	</section>
)}
