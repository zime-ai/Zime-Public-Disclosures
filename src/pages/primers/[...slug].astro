---
import { render } from 'astro:content';
import PrimerLayout from '../../layouts/PrimerLayout.astro';
import { getArtifacts, routeParams } from '../../utils/content';

export async function getStaticPaths() {
	return (await getArtifacts('primers')).map(routeParams);
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PrimerLayout entry={entry}><Content /></PrimerLayout>
