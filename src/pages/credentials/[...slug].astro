---
import { render } from 'astro:content';
import CredentialsLayout from '../../layouts/CredentialsLayout.astro';
import { getArtifacts, routeParams } from '../../utils/content';

export async function getStaticPaths() {
	return (await getArtifacts('credentials')).map(routeParams);
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CredentialsLayout entry={entry}><Content /></CredentialsLayout>
