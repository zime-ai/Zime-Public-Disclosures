---
import { render } from 'astro:content';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import { getArtifacts, routeParams } from '../../utils/content';

export async function getStaticPaths() {
	return (await getArtifacts('concepts')).map(routeParams);
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ConceptLayout entry={entry}><Content /></ConceptLayout>
