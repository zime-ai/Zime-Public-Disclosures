  "version": "0.1.0",
  "private": true,
  "description": "Zime Public Disclosures: canonical Markdown corpus and Astro + Starlight site.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:manifest && astro build",
