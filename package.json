    "validate:content": "node scripts/validate-content.mjs",
    "validate:relationships": "node scripts/validate-relationships.mjs",
    "validate:public-boundary": "node scripts/validate-public-boundary.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "build:manifest": "node scripts/build-manifest.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.42.4",
