{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zime-ai/Zime-Public-Disclosures/schemas/disclosure.schema.json",
  "title": "Disclosure",
  "description": "Mirrors the Zod schema in src/content.config.ts. Keep both in sync.",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "artifact_type",
    "status",
    "version",
    "declaring_party",
    "canonical_path",
    "subtype"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "under_review",
        "approved",
        "staged",
        "published",
        "amended",
        "superseded",
        "withdrawn"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "shared"
      ]
    },
    "version": {
      "type": "string"
    },
    "principles_version": {
      "type": "string"
    },
    "declaring_party": {
      "type": "object",
      "required": [
        "name",
        "entity_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^ENT-[A-Z0-9-]+$"
        },
        "declaration_authority": {
          "type": "string"
        }
      }
    },
    "accountable_owner": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        }
      }
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    },
    "canonical_path": {
      "type": "string",
      "pattern": "^/.*/$"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string"
    },
    "inquiry_url": {
      "type": "string"
    },
    "correction_url": {
      "type": "string"
    },
    "ai_assistance": {
      "type": "object",
      "required": [
        "used",
        "human_review"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_review": {
          "enum": [
            "required",
            "completed",
            "not_required"
          ]
        }
      }
    },
    "structured_data_type": {
      "type": "string"
    },
    "artifact_type": {
      "const": "disclosure"
    },
    "subtype": {
      "enum": [
        "category",
        "product",
        "partnership",
        "customer_evidence",
        "research",
        "leadership",
        "amendment"
      ]
    },
    "commercial_interest": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_type",
          "public_status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[A-Z0-9-]+$"
          },
          "claim_type": {
            "enum": [
              "verified_fact",
              "institutional_fact",
              "assessment",
              "interpretation",
              "category_interpretation",
              "promise",
              "offer",
              "assumption",
              "scenario",
              "forecast",
              "design_intent",
              "open_question"
            ]
          },
          "public_status": {
            "enum": [
              "verified",
              "qualified",
              "contested",
              "withdrawn"
            ]
          },
          "credentials_path": {
            "type": "string"
          }
        }
      }
    },
    "related_primer": {
      "type": "string"
    },
    "related_credentials": {
      "type": "string"
    }
  }
}
